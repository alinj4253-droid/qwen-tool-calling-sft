{"id": "ma-02", "category": "multi_argument", "messages": [{"role": "user", "content": "请在日历上创建事件：标题填“课题组组会”，日期填 2026-09-28，开始时间填 19:00，结束时间填 21:00，地点填“口腔医学院305”。"}], "tools": [{"type": "function", "function": {"name": "create_calendar_event", "description": "创建日历事件", "parameters": {"type": "object", "properties": {"title": {"type": "string", "description": "事件标题"}, "date": {"type": "string", "description": "日期 YYYY-MM-DD"}, "start_time": {"type": "string", "description": "开始时间 HH:MM"}, "end_time": {"type": "string", "description": "结束时间 HH:MM"}, "location": {"type": "string", "description": "地点"}}, "required": ["title", "date", "start_time", "end_time"]}}}], "expect": {"mode": "tool", "calls": [{"name": "create_calendar_event", "arguments": {"title": "课题组组会", "date": "2026-09-28", "start_time": "19:00", "end_time": "21:00", "location": "口腔医学院305"}}]}}
{"id": "ma-03", "category": "multi_argument", "messages": [{"role": "user", "content": "Send an email to boss@company.com with subject 'Q3 report' and body 'The Q3 report is attached.'"}], "tools": [{"type": "function", "function": {"name": "send_email", "description": "发送电子邮件", "parameters": {"type": "object", "properties": {"to": {"type": "string", "description": "收件人邮箱"}, "subject": {"type": "string", "description": "邮件主题"}, "body": {"type": "string", "description": "邮件正文"}}, "required": ["to", "subject", "body"]}}}], "expect": {"mode": "tool", "calls": [{"name": "send_email", "arguments": {"to": "boss@company.com", "subject": "Q3 report", "body": "The Q3 report is attached."}}]}}
{"id": "ma-04", "category": "multi_argument", "messages": [{"role": "user", "content": "请用搜索工具搜索，query 参数填“4090 LoRA 训练”，max_results 填 5。"}], "tools": [{"type": "function", "function": {"name": "search_web", "description": "在网上搜索信息", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "搜索关键词"}, "max_results": {"type": "integer", "description": "返回结果数量"}}, "required": ["query"]}}}], "expect": {"mode": "tool", "calls": [{"name": "search_web", "arguments": {"query": "4090 LoRA 训练", "max_results": 5}}]}}
{"id": "pc-01", "category": "parallel_calls", "messages": [{"role": "user", "content": "请同时查一下北京和上海在 2026-10-01 的天气。"}], "tools": [{"type": "function", "function": {"name": "get_weather", "description": "查询指定城市的天气", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "城市名称"}, "date": {"type": "string", "description": "日期，格式 YYYY-MM-DD"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "温度单位"}}, "required": ["city"]}}}], "expect": {"mode": "tool", "calls": [{"name": "get_weather", "arguments": {"city": "北京", "date": "2026-10-01"}}, {"name": "get_weather", "arguments": {"city": "上海", "date": "2026-10-01"}}]}}
